#!/usr/bin/env bash
# 个人技能同步：把本仓库 skills/* 分发到各 co-agent 的技能目录。
#
# 用法:
#   sync                # 同步全部已配置且可用的 agent
#   sync kimi-code      # 只同步指定 agent
#
# 源头永远在本仓库（git 管理、多机同步）；agent 目录里的是副本，
# 直接改副本会在下次 sync 时被覆盖——要改请改本仓库再 sync。
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/skills"

dest_for() {
  case "$1" in
    kimi-code)   echo "$HOME/.kimi-code/skills" ;;
    claude-code) echo "$HOME/.claude/skills" ;;
    # 新 agent 在这里加一行：
    #   agent名) echo "$HOME/<它的技能目录>" ;;
    *)           return 1 ;;
  esac
}

agents=("$@")
if [ ${#agents[@]} -eq 0 ]; then
  agents=(kimi-code claude-code)
fi

for a in "${agents[@]}"; do
  if ! dest=$(dest_for "$a"); then
    echo "[$a] 跳过：未配置目标目录"
    continue
  fi
  mkdir -p "$dest"
  for d in "$SRC"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    rm -rf "$dest/$name"
    cp -R "$d" "$dest/$name"
    echo "  $name → $dest/$name"
  done
  echo "[$a] 同步完成"
done
